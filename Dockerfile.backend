# Python geospatial backend with GDAL and CBC solver support.
FROM python:3.11-slim-bookworm
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=4 -o Acquire::http::Timeout=45 -o Acquire::https::Timeout=45 update \
    && apt-get install -y --no-install-recommends gdal-bin libgdal-dev build-essential coinor-cbc \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements.txt .
RUN pip install --no-cache-dir --retries 4 --timeout 60 -r requirements.txt
COPY . .
RUN mkdir -p data/cache outputs_run tmp/uploads
# Verify that the installed native CBC actually runs on the build platform.
RUN python -c "from time import monotonic; import pulp; from oasis.core.optimization.cbc import solve_bounded_cbc; p=pulp.LpProblem('smoke'); x=pulp.LpVariable('x', cat='Binary'); p+=x; p+=x>=1; assert solve_bounded_cbc(p, monotonic()+10)=='Optimal'; assert x.value()==1"
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
