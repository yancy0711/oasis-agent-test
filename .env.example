# All server-default credentials live in this project-root file.
# Copy to .env, add local keys, and never commit .env.
# LLM providers (configure only those you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=OASIS Agent

# Backend-only data and routing credentials
CENSUS_API_KEY=
ORS_API_KEY=
MAPILLARY_ACCESS_TOKEN=

# Browser-visible CARTO Basemaps key, served through /api/v1/config.
CARTO_BASEMAP_API_KEY=

# Optional OSM endpoint for planner and resident discovery.
# Public Overpass needs no key; hosted providers may require authentication.
# OASIS_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
# A compatible hosted/self-hosted interpreter URL can replace the public services.
# Example after obtaining an overpass.ch key (header authentication):
# OASIS_OVERPASS_URL=https://api.overpass.ch/v1/interpreter
OVERPASS_CH_API_KEY=
# RESIDENT_OVERPASS_URL overrides it for resident discovery only
# Optional real operator contact; do not use a made-up email.
# OASIS_OSM_USER_AGENT=OASIS-Agent/1.0 (your actual contact URL or email)
# RESIDENT_OVERPASS_URL=https://overpass.private.coffee/api/interpreter

# Optional deployment overrides
# Compose sets these to /app paths; use host paths only for native Python runs.
# OASIS_CONFIG_PATH=/app/config/settings.yaml
# OASIS_CACHE_DIR=/app/data/cache
# OASIS_OUTPUT_DIR=/app/outputs_run
