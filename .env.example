# Copy to .env and fill in; .env is gitignored, pls make a copy of this file as env.example and fill in your own keys for local development. Do not commit your personal keys to git!
OPENROUTER_API_KEY=   # your OpenRouter API key, see https://openrouter.ai
OPENROUTER_SITE_URL=   # Optional, can be left blank.
OPENROUTER_APP_NAME=OASIS Agent

CENSUS_API_KEY=          # your US Census API key, see https://api.census.gov/data/key_signup.html
ORS_API_KEY=             # your OpenRouteService API key, see https://openrouteservice.org/sign-up/
